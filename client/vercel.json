{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron/mongodb-keepalive.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/mongodb-keepalive",
      "schedule": "17 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
